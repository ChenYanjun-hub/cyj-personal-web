# AI 数字分身 · DeepSeek API
# ---------------------------------------------------------------
# 必填：你的 DeepSeek API Key（在 https://platform.deepseek.com 申请）
# 密钥只在服务端读取，绝不出现在前端代码或仓库里。
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：覆盖默认模型（默认 deepseek-chat；想试 deepseek-reasoner 取消注释）
# DEEPSEEK_MODEL=deepseek-chat

# 可选：覆盖默认 API base URL（如需要自建代理）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------
# 使用方法：
#   1. 把这个文件复制为 .env.local（.env.local 已经在 .gitignore 里，不会入库）
#   2. 把 DEEPSEEK_API_KEY 换成你真实的 key
#   3. 重启 dev server: pnpm dev
# 阿里云部署时把 DEEPSEEK_API_KEY 写到 PM2 的 ecosystem.config.js 或者 .env 里

# 留言板 · 站长删除留言用的管理 token（自己生成一串随机字符串，DELETE /api/board/[id] 校验）
# 生成：openssl rand -hex 24
BOARD_ADMIN_TOKEN=
# 可选 · 留言板 SQLite 文件路径（默认 web/data/board.db；生产建议指向部署目录之外的持久化路径）
# BOARD_DB_PATH=/var/lib/cyjweb/board.db
